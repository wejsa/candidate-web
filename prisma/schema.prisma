// candidate-web — Prisma 스키마 SSOT
//
// 본 task(CANDID-002)는 datasource + generator + 빈 model 자리만 정의합니다.
// 실제 model 정의는 후속 task가 분할 담당:
//   CANDID-003 → 인증 도메인 (users, auth_providers, email_verification, password_reset_token)
//   CANDID-004 → 공고 조회 (job_categories, job_postings, job_posting_questions)
//   CANDID-005 → 지원서 도메인 (applications, application_drafts, application_answers,
//                 resume_files, portfolio_links, application_status_history,
//                 interview_schedules, audit_logs)
//
// Migration 명명 규약: `{timestamp}_candid-{NNN}-{설명}` (Prisma는 prefix만 강제, 본 규약은 task 추적성용)
// 명령어: `pnpm db:migrate` (로컬) / `pnpm db:deploy` (CI·prod) — `db push`는 금지

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// === CANDID-003: 인증 도메인 ===
// PRD §3.3.1, §3.3.2 + US-AUTH-001~004 기반.
// CANDID-008 적용: phone, birth_date는 AES-256-GCM 암호화하여 BYTEA로 저장.
//                  애플리케이션 코드는 string(평문)으로 다루고, lib/prisma/extends.ts의
//                  result extension이 자동 복호화. 쓰기는 encryptUserPiiInput 헬퍼 명시 호출.
//                  phone_key_version / birth_date_key_version으로 키 회전 추적.

enum UserStatus {
  ACTIVE
  LOCKED
  WITHDRAWN
}

enum AuthProviderType {
  GOOGLE
  GITHUB
}

model User {
  id                  Int        @id @default(autoincrement())
  email               String     @unique @db.VarChar(255)
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  name                String     @db.VarChar(100)
  // CANDID-008: AES-256-GCM ciphertext (iv 12B || tag 16B || ct). 평문 길이는 ISO date / 휴대폰 수준.
  phone               Bytes?
  phoneKeyVersion     Int?       @default(1) @map("phone_key_version") @db.SmallInt
  birthDate           Bytes?     @map("birth_date")
  birthDateKeyVersion Int?       @default(1) @map("birth_date_key_version") @db.SmallInt
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  status              UserStatus @default(ACTIVE)
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until")
  withdrawnAt         DateTime?  @map("withdrawn_at")
  // CANDID-022: 익명화 실행 시각. withdrawnAt = 사용자 요청 시각, anonymizedAt = 익명화 트랜잭션 성공 시각.
  // BR-PII-04 1년 자동 파기 배치(CANDID-029)가 idx_users_anonymized_at으로 만료 row 스캔.
  anonymizedAt        DateTime?  @map("anonymized_at")
  // CANDID-010: 개인정보보호법 §22 동의 시각 기록 (boolean보다 감사 추적성 우수).
  // 약관/개인정보 미동의로 가입 불가 — boolean 검증은 zod에서, DB는 시각만 기록.
  // BR-PII-05 옵션 C: ageConfirmedAt = 만 14세 이상 자기 확인 시각. 지원서 시점에 birth_date 정밀 검증.
  termsAgreedAt       DateTime?  @map("terms_agreed_at")
  privacyAgreedAt     DateTime?  @map("privacy_agreed_at")
  marketingAgreedAt   DateTime?  @map("marketing_agreed_at")
  ageConfirmedAt      DateTime?  @map("age_confirmed_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  authProviders          AuthProvider[]
  emailVerifications     EmailVerification[]
  passwordResetTokens    PasswordResetToken[]
  refreshTokens          RefreshToken[]
  applications           Application[]
  applicationDrafts      ApplicationDraft[]
  resumeFiles            ResumeFile[]
  idempotencyKeys        IdempotencyKey[] // CANDID-018: 멱등성 키 저장소
  changedStatusHistories ApplicationStatusHistory[] @relation("changedBy")

  @@index([status], map: "idx_users_status")
  // CANDID-022: BR-PII-04 1년 파기 배치(CANDID-029) 스캔용 — anonymizedAt NOT NULL row만 대상.
  @@index([anonymizedAt], map: "idx_users_anonymized_at")
  @@map("users")
}

model AuthProvider {
  id              Int              @id @default(autoincrement())
  userId          Int              @map("user_id")
  provider        AuthProviderType
  providerUserId  String           @map("provider_user_id") @db.VarChar(255)
  profileImageUrl String?          @map("profile_image_url") @db.VarChar(500)
  linkedAt        DateTime         @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], map: "uk_auth_providers_provider_pid")
  @@unique([userId, provider], map: "uk_auth_providers_user_provider")
  @@map("auth_providers")
}

model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  // CANDID-010: 평문 token 대신 sha256 해시 저장 — DB 유출 시 계정 탈취 차단.
  // 클라이언트 URL은 평문, DB 조회는 sha256(token) hex. RefreshToken.tokenHash와 동일 패턴.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") // 24h 후 (US-AUTH-001)
  consumedAt DateTime? @map("consumed_at")
  lastSentAt DateTime  @default(now()) @map("last_sent_at") // 60s 재발송 쿨다운 enforcement
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_email_verifications_user")
  // CANDID-010 db-designer 권고: 만료 정리 배치 최적화.
  // 활성 토큰 부분 인덱스 (idx_email_verifications_active WHERE consumed_at IS NULL)는
  // Prisma @@index 미지원 → migration.sql에서 raw SQL로 추가.
  @@index([expiresAt], map: "idx_email_verifications_expires")
  @@map("email_verifications")
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  // CANDID-020: 평문 token → sha256 token_hash 격상 (email_verifications/refresh_tokens 정합).
  // 토큰(high-entropy random)을 sha256(CHAR(64))로 저장 — DB 유출 시 계정 탈취 차단.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") // 30분 후, 일회용 (US-AUTH-004)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_tokens_user")
  // 만료 토큰 정리 배치(CANDID-029)용.
  @@index([expiresAt], map: "idx_password_reset_tokens_expires")
  // user당 활성(미소진) reset 토큰 1건 강제 — 재발송 TOCTOU race 차단 (CANDID-036 패턴).
  // 부분 UNIQUE(WHERE consumed_at IS NULL)는 Prisma 미표현 → migration.sql raw SQL로 생성:
  //   uk_password_reset_active_per_user
  @@map("password_reset_tokens")
}

// === CANDID-006: Refresh Token 화이트리스트 ===
// BR-AUTH-05 (비밀번호 변경 시 모든 Refresh Token 무효화)를 지원하기 위해 서버 측 인덱싱 필수.
// 토큰 자체(high-entropy random)는 sha256 해시로 저장 — bcrypt는 refresh 빈도(분당)에 과부하.
// rotation reuse detection 로직은 CANDID-021에 위임. 본 task에선 컬럼만 사전 정의(forward-compatible).
model RefreshToken {
  id              BigInt    @id @default(autoincrement())
  userId          Int       @map("user_id")
  // sha256(token) hex — UNIQUE로 O(1) 조회 + rainbow table 무관 (토큰 자체 high-entropy)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  // rotation chain UUID — 같은 family 내 토큰이 두 번 사용되면 전체 family revoke (CANDID-021)
  familyId        String    @map("family_id") @db.Uuid
  rotationCounter Int       @default(0) @map("rotation_counter")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  // "rotated" | "logout" | "password_change" | "reuse_detected" — 감사 추적
  revokedReason   String?   @map("revoked_reason") @db.VarChar(50)
  userAgent       String?   @map("user_agent") @db.VarChar(500)
  ipAddress       String?   @map("ip_address") @db.Inet
  createdAt       DateTime  @default(now()) @map("created_at")
  // revoke/rotation으로 변경되는 가변 엔티티 — 마지막 변경 시각 추적 (감사 정합성)
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // BR-AUTH-05 일괄 revoke 쿼리(UPDATE WHERE user_id=? AND revoked_at IS NULL)에 최적화
  @@index([userId, revokedAt], map: "idx_refresh_tokens_user_active")
  // TTL 정리 야간 배치(CANDID-029)용
  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  // CANDID-021 reuse detection chain 추적
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

// === CANDID-004: 공고 조회 ===
// PRD §3.3.3 + ERD §3.2 + BR-JOB-01~04 기반.
// 어드민 측에서 작성·관리하는 데이터를 지원자 측에서 조회 전용으로 노출.
// content_html은 어드민 sanitize 결과를 그대로 저장. 조회 시 한 번 더 sanitize (BR-JOB-04).

enum EmploymentType {
  FULL_TIME
  CONTRACT
  INTERN
}

enum CareerLevel {
  NEW
  EXPERIENCED
  ANY
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SELECT
  MULTI_SELECT
}

model JobCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobPostings JobPosting[]

  @@index([active, sortOrder], map: "idx_job_categories_active_sort")
  @@map("job_categories")
}

model JobPosting {
  id             Int            @id @default(autoincrement())
  title          String         @db.VarChar(200)
  jobCategoryId  Int            @map("job_category_id")
  employmentType EmploymentType @map("employment_type")
  careerLevel    CareerLevel    @map("career_level")
  contentHtml    String         @map("content_html") @db.Text
  opensAt        DateTime       @map("opens_at")
  closesAt       DateTime?      @map("closes_at") // NULL = 상시 모집
  status         JobStatus      @default(DRAFT)
  viewCount      BigInt         @default(0) @map("view_count")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  jobCategory       JobCategory          @relation(fields: [jobCategoryId], references: [id], onDelete: Restrict)
  questions         JobPostingQuestion[]
  applications      Application[]
  applicationDrafts ApplicationDraft[]

  @@index([status, closesAt], map: "idx_job_postings_status_closes_at")
  @@index([jobCategoryId], map: "idx_job_postings_category")
  @@index([opensAt, status], map: "idx_job_postings_opens_at_status")
  @@map("job_postings")
}

model JobPostingQuestion {
  id           Int          @id @default(autoincrement())
  jobPostingId Int          @map("job_posting_id")
  questionText String       @map("question_text") @db.Text
  questionType QuestionType @default(LONG_TEXT) @map("question_type")
  required     Boolean      @default(false)
  maxLength    Int?         @map("max_length")
  // SELECT / MULTI_SELECT 선택지 (예: ["주니어", "시니어"]). 단순 텍스트 타입에서는 NULL.
  optionsJson  Json?        @map("options_json") @db.JsonB
  sortOrder    Int          @default(0) @map("sort_order")
  // CANDID-005 Step 2 (L-015 R1 종결): soft-archive. 신규 응답 차단(앱 레이어 where 필터),
  // application_answers는 RESTRICT FK로 보존 → 어드민 hard-delete 불가, archived_at만 set.
  archivedAt   DateTime?    @map("archived_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  jobPosting JobPosting          @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  answers    ApplicationAnswer[]

  @@index([jobPostingId, sortOrder], map: "idx_jpq_posting_sort")
  @@map("job_posting_questions")
}

// === CANDID-005: 지원서 도메인 ===
// PRD §3.3.4~3.3.11 + ERD §3.2 + BR-APP-01~06 / BR-PII-03 / BR-TX-01,02 / BR-FILE-01~07 기반.
// Step 1: 핵심 지원서(applications + drafts + sequences) + 6 enum 일괄 정의.
// PII snapshot 컬럼(applicants_*_snapshot)은 NULLABLE Bytes로 사전 정의.
// 암복호화 extension wiring 및 단위 테스트는 CANDID-005-FU1(후속 task)에서 처리.

enum ApplicationResult {
  IN_PROGRESS
  PASSED
  FAILED
  WITHDRAWN
}

enum StageType {
  SUBMITTED
  DOC_REVIEW
  INTERVIEW_1
  INTERVIEW_2
  OFFER
  HIRED
  REJECTED
}

enum InterviewScheduleStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum PortfolioLinkType {
  GITHUB
  NOTION
  BLOG
  LINKEDIN
  FIGMA
  ETC
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  APPLICATION_SUBMIT
  APPLICATION_WITHDRAW
  PII_VIEW
  PASSWORD_CHANGE
  USER_WITHDRAWN
  // CANDID-022 — 탈퇴 분기별 상세 이벤트 (USER_WITHDRAWN은 분기와 무관한 요청 시점 이벤트로 유지).
  USER_ANONYMIZED
  USER_HARD_DELETED
}

model Application {
  id                               Int               @id @default(autoincrement())
  applicationNumber                String            @unique @map("application_number") @db.VarChar(20) // BR-APP-05: A-YYYYMM-NNNNN
  userId                           Int               @map("user_id")
  jobPostingId                     Int               @map("job_posting_id")
  currentStage                     StageType         @default(SUBMITTED) @map("current_stage")
  result                           ApplicationResult @default(IN_PROGRESS)
  submittedAt                      DateTime          @map("submitted_at")
  withdrawnAt                      DateTime?         @map("withdrawn_at")
  // CANDID-023 (US-MY-003): 지원 철회 사유 — 선택 입력. 자유 텍스트(앱 레이어 sanitize, L-006). PII 아님.
  withdrawReason                   String?           @map("withdraw_reason") @db.VarChar(500)
  // PII snapshot (BR-PII-03 익명화 보존). CANDID-008 패턴 미러 — AES-256-GCM ciphertext.
  // 본 Step은 NULLABLE 컬럼만 정의. extension wiring/암복호화는 CANDID-005-FU1.
  applicantNameSnapshot            Bytes?            @map("applicant_name_snapshot")
  applicantNameSnapshotKeyVersion  Int?              @default(1) @map("applicant_name_snapshot_key_version") @db.SmallInt
  applicantEmailSnapshot           Bytes?            @map("applicant_email_snapshot")
  applicantEmailSnapshotKeyVersion Int?              @default(1) @map("applicant_email_snapshot_key_version") @db.SmallInt
  phoneSnapshot                    Bytes?            @map("phone_snapshot")
  phoneSnapshotKeyVersion          Int?              @default(1) @map("phone_snapshot_key_version") @db.SmallInt
  birthDateSnapshot                Bytes?            @map("birth_date_snapshot")
  birthDateSnapshotKeyVersion      Int?              @default(1) @map("birth_date_snapshot_key_version") @db.SmallInt
  addressSnapshot                  Bytes?            @map("address_snapshot")
  addressSnapshotKeyVersion        Int?              @default(1) @map("address_snapshot_key_version") @db.SmallInt
  createdAt                        DateTime          @default(now()) @map("created_at")
  updatedAt                        DateTime          @updatedAt @map("updated_at")

  user               User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobPosting         JobPosting                 @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  answers            ApplicationAnswer[]
  resumeFiles        ResumeFile[]
  portfolioLinks     PortfolioLink[]
  statusHistories    ApplicationStatusHistory[]
  interviewSchedules InterviewSchedule[]

  // BR-APP-01 활성 지원서 UNIQUE 제약은 partial(`WHERE result <> 'WITHDRAWN'`)이라 Prisma schema에서 직접 표현 불가 — migration.sql에서 정의.
  @@index([userId, submittedAt(sort: Desc)], map: "idx_applications_user_submitted")
  @@index([jobPostingId, result], map: "idx_applications_posting_result")
  @@map("applications")
}

model ApplicationDraft {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  jobPostingId Int      @map("job_posting_id")
  payloadJson  Json     @map("payload_json") @db.JsonB // 작성 중 zod 직렬화 데이터
  lastSavedAt  DateTime @map("last_saved_at")
  version      Int      @default(1) // 낙관적 락 (BR-APP-02)
  createdAt    DateTime @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting     JobPosting      @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  resumeFiles    ResumeFile[]
  portfolioLinks PortfolioLink[]

  @@unique([userId, jobPostingId], map: "uk_drafts_user_posting")
  @@index([lastSavedAt], map: "idx_drafts_last_saved") // BR-FILE-06 30일 배치 정리
  @@map("application_drafts")
}

// 보조 테이블: application_number 월별 시퀀스 (BR-APP-05).
// 앱 레이어 generator가 UPDATE ... SET last_seq = last_seq + 1 ... RETURNING으로
// atomic single-call (CANDID-018 D-H001 fix — L-024 race-safe). 별도 SELECT FOR UPDATE 불필요.
model ApplicationNumberSequence {
  yearMonth String   @id @map("year_month") @db.VarChar(6) // "202605" 등
  lastSeq   Int      @default(0) @map("last_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("application_number_sequences")
}

// CANDID-018 — 멱등성 키 저장소 (BR-APP-06).
// 클라이언트 Idempotency-Key 헤더 + user_id로 격리. 24시간 TTL.
// composite PK (user_id, key) — 사용자 간 격리 강제 (다른 user의 같은 key는 별도 row).
//
// onDelete: Cascade 근거 (D-H004 — PR #67 review):
//   BR-PII-03 회원 탈퇴 정리에서 hard delete 경로가 발생하면 idempotency_keys도 함께 삭제.
//   대부분의 탈퇴 흐름은 익명화(soft)이지만 hard delete 시 잔존 데이터가 없도록 보장.
//   response_json은 PII-free (store.ts StoreInput.responseJson JSDoc 참조)이나
//   user_id 컬럼 자체가 잔존하면 BR-PII-03 위반 — CASCADE로 즉시 회수.
//
// cleanup wiring (D-H005 — PR #67 review):
//   24h 경과 row는 (a) lookup 시 lazy delete (store.ts) + (b) CANDID-029 야간 배치로 양면 정리.
//   본 PR 범위는 idx_idempotency_expires 인덱스만 제공 (배치 구현은 CANDID-029).
model IdempotencyKey {
  userId         Int      @map("user_id")
  key            String   @db.VarChar(64) // UUID v4 권장 — schema 단에서 36자 length 강제 (lib/idempotency/schema.ts)
  requestHash    String   @map("request_hash") @db.VarChar(64) // SHA-256 of stable-stringify(body)
  responseJson   Json     @map("response_json") @db.JsonB // PII-free 강제 (S-H001 — store.ts JSDoc 참조)
  responseStatus Int      @map("response_status") @db.SmallInt
  expiresAt      DateTime @map("expires_at") // 24h after createdAt; <= now → 만료 (exclusive — D-H002)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key], map: "pk_idempotency_keys")
  @@index([expiresAt], map: "idx_idempotency_expires") // CANDID-029 야간 배치 정리용 + lookup lazy delete 보조
  @@map("idempotency_keys")
}

// === CANDID-005 Step 2: 첨부/응답 ===
// PRD §3.3.6~3.3.7 (resume_files / portfolio_links) + ERD §3.2 (application_answers) 기반.
// L-015 R1 종결: application_answers.question_id RESTRICT + JobPostingQuestion.archivedAt soft-archive.

model ApplicationAnswer {
  id                Int      @id @default(autoincrement())
  applicationId     Int      @map("application_id")
  questionId        Int      @map("question_id")
  answerText        String?  @map("answer_text") @db.Text // SHORT_TEXT / LONG_TEXT 응답
  answerOptionsJson Json?    @map("answer_options_json") @db.JsonB // SELECT / MULTI_SELECT 응답
  createdAt         DateTime @default(now()) @map("created_at")

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    JobPostingQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict) // L-015: 응답 보존

  @@unique([applicationId, questionId], map: "uk_answers_app_question") // 질문당 1응답
  @@map("application_answers")
}

model ResumeFile {
  id               Int             @id @default(autoincrement())
  ownerUserId      Int             @map("owner_user_id")
  // applicationId와 draftId는 동시에 NOT NULL 불가 (앱 레이어가 "exactly one" 보장).
  // 부모 SET NULL 발동 시 둘 다 NULL인 orphan 상태 허용 (BR-PII-03 메타 보존).
  applicationId    Int?            @map("application_id")
  draftId          Int?            @map("draft_id")
  originalFilename String          @map("original_filename") @db.VarChar(255)
  storedPath       String          @map("stored_path") @db.VarChar(500) // S3 키 또는 UUID 재명명 경로
  contentType      String          @map("content_type") @db.VarChar(100) // MIME 화이트리스트
  fileSize         BigInt          @map("file_size") // bytes
  checksumSha256   String          @map("checksum_sha256") @db.VarChar(64) // 무결성 검증
  virusScanStatus  VirusScanStatus @default(PENDING) @map("virus_scan_status")
  scannedAt        DateTime?       @map("scanned_at")
  uploadedAt       DateTime        @default(now()) @map("uploaded_at")

  owner       User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  application Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  draft       ApplicationDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  // "At most one" CHECK (application_id, draft_id 동시 NOT NULL 금지) — migration.sql에서 정의.
  // C001 fix: 기존 XOR CHECK는 FK SET NULL과 충돌하여 BR-FILE-06 batch failure 유발 → "at most one"으로 완화.
  //
  // CANDID-016 Step 1 — partial UNIQUE 2개를 migration.sql에서 raw SQL로 정의 (Prisma @@unique partial 미지원).
  //   uk_resume_files_one_per_draft (draft_id) WHERE draft_id IS NOT NULL
  //   uk_resume_files_one_per_app   (application_id) WHERE application_id IS NOT NULL
  // 효과: 동일 draft/application 당 활성 첨부 최대 1건 DB 강제 (US-APP-003 "최대 첨부 1개" + 동시 탭 race 차단).
  @@map("resume_files")
}

model PortfolioLink {
  id            Int               @id @default(autoincrement())
  applicationId Int?              @map("application_id") // XOR with draftId
  draftId       Int?              @map("draft_id") // XOR with applicationId
  linkType      PortfolioLinkType @map("link_type")
  url           String            @db.VarChar(1000)
  memo          String?           @db.VarChar(500)
  sortOrder     Int               @default(0) @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")

  application Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  draft       ApplicationDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  // XOR CHECK (application_id IS NULL <> draft_id IS NULL) — migration.sql에서 정의.
  // 최대 5개 검증은 앱 레이어 (US-APP-004).
  @@map("portfolio_links")
}

// === CANDID-005 Step 3: 이력/면접/감사 ===
// PRD §3.3.8~3.3.9 (status_history / interview_schedules) + audit_logs(골격, CANDID-026 본격 도입).

model ApplicationStatusHistory {
  id                 Int        @id @default(autoincrement())
  applicationId      Int        @map("application_id")
  fromStage          StageType? @map("from_stage") // 초기 SUBMITTED는 NULL
  toStage            StageType  @map("to_stage")
  changedByUserId    Int?       @map("changed_by_user_id") // 시스템 자동 변경은 NULL
  changedAt          DateTime   @default(now()) @map("changed_at")
  visibleToCandidate Boolean    @default(true) @map("visible_to_candidate") // 내부 이력 미노출

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  changedBy   User?       @relation("changedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, changedAt(sort: Desc)], map: "idx_status_history_app_changed")
  @@map("application_status_history")
}

model InterviewSchedule {
  id            Int                     @id @default(autoincrement())
  applicationId Int                     @map("application_id")
  stage         StageType
  scheduledAt   DateTime                @map("scheduled_at")
  locationOrUrl String                  @map("location_or_url") @db.VarChar(500) // 오프라인 주소 또는 화상 링크
  status        InterviewScheduleStatus @default(SCHEDULED)
  icsUid        String                  @unique @map("ics_uid") @db.VarChar(120) // .ics 발급 멱등성
  createdAt     DateTime                @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, scheduledAt], map: "idx_interview_app_scheduled")
  @@map("interview_schedules")
}

// audit_logs: 본 Step은 골격만 정의 — 본격 도입은 CANDID-026 (감사 AOP + traceId 전파).
// FK 미설정 (PHI 분리 원칙 — actorUserId는 plain BigInt, JOIN은 앱 레이어).
// 파티셔닝(PARTITION BY RANGE occurred_at)은 CANDID-026에서 운영 단계 도입.
model AuditLog {
  id           BigInt         @id @default(autoincrement())
  occurredAt   DateTime       @default(now()) @map("occurred_at")
  actorUserId  Int?           @map("actor_user_id") // FK 미설정 — PHI 분리
  eventType    AuditEventType @map("event_type")
  resourceType String?        @map("resource_type") @db.VarChar(50) // "application" 등
  resourceId   String?        @map("resource_id") @db.VarChar(64)
  ipAddress    String?        @map("ip_address") @db.Inet
  userAgent    String?        @map("user_agent") @db.VarChar(500)
  metadataJson Json?          @map("metadata_json") @db.JsonB
  // CANDID-026 Step 1 — 분산 추적 traceId. 영구 NULL 허용(과거 row 백필 불가). UUID(36)/W3C trace-id(32) 수용.
  traceId      String?        @map("trace_id") @db.VarChar(36)

  @@index([actorUserId, occurredAt(sort: Desc)], map: "idx_audit_actor_occurred")
  @@index([resourceType, resourceId, occurredAt(sort: Desc)], map: "idx_audit_resource")
  @@index([eventType, occurredAt(sort: Desc)], map: "idx_audit_event")
  // partial 인덱스 idx_audit_trace (trace_id) WHERE trace_id IS NOT NULL는 Prisma 미표현 →
  // migration.sql raw SQL로 생성(과거 NULL row 인덱스 비대 방지).
  @@map("audit_logs")
}
