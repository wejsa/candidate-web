{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/wejsa/ai-crew-kit/.claude/schemas/secrets-patterns.schema.json",
  "title": "Secrets Patterns Library",
  "description": "skill-health-check이 자동 로드하는 시크릿/민감정보 정규식 패턴 정의 스키마. _base는 common(hardcoded+runtime), 도메인은 domain.patterns 보유. SSOT: .claude/domains/_base/health/README.md",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of this patterns file"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this patterns file scope"
    },
    "common": { "$ref": "#/definitions/commonSection" },
    "domain": { "$ref": "#/definitions/domainSection" }
  },
  "oneOf": [
    {
      "required": ["common"],
      "not": { "required": ["domain"] },
      "description": "_base/health/secrets-patterns.json — common patterns only"
    },
    {
      "required": ["domain"],
      "not": { "required": ["common"] },
      "description": "{domain}/health/secrets-patterns.json — domain-specific patterns only"
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "commonSection": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "hardcoded": {
          "type": "array",
          "items": { "$ref": "#/definitions/patternEntry" },
          "description": "SEC-05 — hardcoded secret patterns (high confidence)"
        },
        "runtime": {
          "type": "array",
          "items": { "$ref": "#/definitions/patternEntry" },
          "description": "SEC-01 — runtime logging patterns (medium allowed for v1.x regression preservation)"
        }
      },
      "additionalProperties": false
    },
    "domainSection": {
      "type": "object",
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/patternEntry" },
          "description": "SEC-07 — domain-specific high-confidence patterns"
        }
      },
      "additionalProperties": false
    },
    "patternEntry": {
      "type": "object",
      "required": ["id", "name", "pattern", "severity", "confidence", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SEC-S\\d{2}$",
          "description": "External pattern ID. Domain files start at SEC-S01 (per-domain namespace)."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "JavaScript-compatible regex (Python re module also compatible)"
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "MAJOR", "MINOR"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "v2.0 MVP: new patterns are high. common.runtime (SEC-S06~S17) is medium for v1.x SEC-01 regression preservation."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "excludeFiles": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Glob patterns to skip during scan"
        },
        "excludeContexts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["env_var_reference", "type_declaration", "comment"]
          },
          "uniqueItems": true,
          "description": "Line context exclusions per skill-health-check SKILL.md SSOT"
        }
      },
      "additionalProperties": false
    }
  }
}
