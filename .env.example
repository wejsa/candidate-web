# 모든 키는 lib/env.ts의 zod 스키마와 정합되어야 합니다.
# 본 task(CANDID-001)에서는 모두 optional — 각 후속 task가 필요 시 required로 격상합니다.

# --- 공통 ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (CANDID-002에서 required로 격상) ---
# 로컬: docker-compose db 서비스 (docker compose up -d db)
# 운영: 관리형 PostgreSQL 연결 문자열 (별도 시크릿 매니저에서 주입 권장)
DATABASE_URL=postgresql://candidate:candidate@localhost:5432/candidate_web

# --- JWT (CANDID-006) ---
# openssl rand -base64 48 로 생성. 최소 32자.
JWT_ACCESS_SECRET=replace-with-32-chars-minimum-random-string
JWT_REFRESH_SECRET=replace-with-32-chars-minimum-random-string

# --- PII 암호화 (CANDID-008) ---
# openssl rand -hex 32 로 생성. AES-256-GCM 키 (64-char hex).
PII_ENCRYPTION_KEY=

# --- OAuth (CANDID-012) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- S3 / MinIO 파일 업로드 (CANDID-016) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- SMTP 이메일 발송 (CANDID-010) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
