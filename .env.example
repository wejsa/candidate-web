# 모든 키는 lib/env.ts의 zod 스키마와 정합되어야 합니다.
# 본 task(CANDID-001)에서는 모두 optional — 각 후속 task가 필요 시 required로 격상합니다.

# --- 공통 ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (CANDID-002에서 required로 격상) ---
# 로컬: docker-compose db 서비스 사용 시 docker-compose.yml의 자격증명과 정합되게 채우기.
#       docker-compose.yml 기본: user=candidate, password=candidate (dev 전용).
# 운영: 관리형 PostgreSQL 연결 문자열 (시크릿 매니저에서 주입 권장).
# 주의: 아래 CHANGE_ME 값을 그대로 두면 lib/env.ts refine 검증에서 부팅이 차단됩니다.
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/candidate_web

# --- 통합 테스트 DB (CANDID-035, optional) ---
# `pnpm test:integration` 실행 시 사용. 미설정 시 dev DB(docker-compose `db`)의
# host/credentials를 재사용하고 `?schema=test_integration` 파라미터만 부여해
# dev schema와 비파괴 공존. 별도 인스턴스를 분리하려면 본 키에 전체 URL 명시.
# TEST_DATABASE_URL=postgresql://candidate:candidate@localhost:5432/candidate_web

# --- JWT (CANDID-006부터 required) ---
# openssl rand -base64 64 로 생성. **최소 64자** (HS512 — RFC 7518: HMAC 키 ≥ 512비트).
# **Access/Refresh secret 분리 필수** (라이프사이클 + 누수 영향 격리) — 동일 값이면 부팅 차단.
# 운영은 시크릿 매니저에서 주입. 미설정 시 lib/env.ts에서 부팅 차단.
JWT_ACCESS_SECRET=replace-with-64-chars-minimum-random-string-for-hs512-access-aaaa
JWT_REFRESH_SECRET=replace-with-64-chars-minimum-random-string-for-hs512-refresh-bb

# Access JWT TTL (기본 30분 = 1800초). US-AUTH-002 정합.
JWT_ACCESS_TTL_SEC=1800
# Refresh Token TTL (기본 14일 = 1209600초). "로그인 상태 유지" 체크 시.
JWT_REFRESH_TTL_SEC=1209600
# Refresh Token TTL (상태유지 미체크 시 1일 = 86400초).
JWT_REFRESH_TTL_SHORT_SEC=86400

# --- PII 암호화 (CANDID-008부터 필수) ---
# openssl rand -hex 32 로 생성. AES-256-GCM 키 (64-char hex).
# 미설정 시 lib/env.ts에서 부팅 차단. dev 환경은 임의 64자 hex 생성 후 사용.
PII_ENCRYPTION_KEY=

# --- OAuth (CANDID-012) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- S3 / MinIO 파일 업로드 (CANDID-016) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- SMTP 이메일 발송 (CANDID-010) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
