# 모든 키는 lib/env.ts의 zod 스키마와 정합되어야 합니다.
# 본 task(CANDID-001)에서는 모두 optional — 각 후속 task가 필요 시 required로 격상합니다.

# --- 공통 ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (CANDID-002에서 required로 격상) ---
# 로컬: docker-compose db 서비스 사용 시 docker-compose.yml의 자격증명과 정합되게 채우기.
#       docker-compose.yml 기본: user=candidate, password=candidate (dev 전용).
# 운영: 관리형 PostgreSQL 연결 문자열 (시크릿 매니저에서 주입 권장).
# 주의: 아래 CHANGE_ME 값을 그대로 두면 lib/env.ts refine 검증에서 부팅이 차단됩니다.
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/candidate_web

# --- 통합 테스트 DB (CANDID-035, optional) ---
# `pnpm test:integration` 실행 시 사용. 미설정 시 dev DB(docker-compose `db`)의
# host/credentials를 재사용하고 `?schema=test_integration` 파라미터만 부여해
# dev schema와 비파괴 공존. 별도 인스턴스를 분리하려면 본 키에 전체 URL 명시.
# TEST_DATABASE_URL=postgresql://candidate:candidate@localhost:5432/candidate_web

# --- JWT (CANDID-006부터 required) ---
# openssl rand -base64 64 로 생성. **최소 64자** (HS512 — RFC 7518: HMAC 키 ≥ 512비트).
# **Access/Refresh secret 분리 필수** (라이프사이클 + 누수 영향 격리) — 동일 값이면 부팅 차단.
# 운영은 시크릿 매니저에서 주입. 미설정 시 lib/env.ts에서 부팅 차단.
JWT_ACCESS_SECRET=replace-with-64-chars-minimum-random-string-for-hs512-access-aaaa
JWT_REFRESH_SECRET=replace-with-64-chars-minimum-random-string-for-hs512-refresh-bb

# Access JWT TTL (기본 30분 = 1800초). US-AUTH-002 정합.
JWT_ACCESS_TTL_SEC=1800
# Refresh Token TTL (기본 14일 = 1209600초). "로그인 상태 유지" 체크 시.
JWT_REFRESH_TTL_SEC=1209600
# Refresh Token TTL (상태유지 미체크 시 1일 = 86400초).
JWT_REFRESH_TTL_SHORT_SEC=86400

# --- PII 암호화 (CANDID-008부터 필수) ---
# openssl rand -hex 32 로 생성. AES-256-GCM 키 (64-char hex).
# 미설정 시 lib/env.ts에서 부팅 차단. dev 환경은 임의 64자 hex 생성 후 사용.
PII_ENCRYPTION_KEY=

# --- 보안 미들웨어 (CANDID-009) ---
# CORS 화이트리스트 (BR-SEC-03) — CSV. NEXT_PUBLIC_APP_URL의 origin은 자동 포함되므로
# 단일 도메인이면 비워둔다. 멀티 도메인 운영 시 추가 origin을 콤마 구분으로 나열.
# 와일드카드(*) 금지 — lib/env.ts refine에서 부팅 차단.
# 예: CORS_ALLOWED_ORIGINS=https://staging.candidate.example.com,https://preview.candidate.example.com
CORS_ALLOWED_ORIGINS=

# HTTPS 강제 (BR-SEC-01) — true 시 HTTP 요청을 308로 https:// 리다이렉트.
# X-Forwarded-Proto(프록시) 또는 nextUrl.protocol 기준. dev는 false 권장, prod는 true.
# 'true'/'1'만 활성. 그 외 값(빈/false/0)은 비활성.
FORCE_HTTPS_REDIRECT=false

# 신뢰된 프록시 뒤에서 X-Forwarded-Proto/For/Host 헤더를 신뢰할지 (Step 2 — H001 보강).
# 운영 LB/CDN/ingress 뒤에서만 true. 직접 노출(localhost/dev) 또는 신뢰되지 않은 경계에서는 false.
# false면 isSecureRequest는 nextUrl.protocol만 사용 — 클라이언트 헤더 위조 우회 차단.
TRUST_PROXY=false

# --- OAuth (CANDID-012) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- S3 / MinIO 파일 업로드 (CANDID-016) ---
# 4개 모두 설정하거나 모두 비워야 함 (부분 설정 부팅 차단 — superRefine).
# 로컬 dev: docker-compose minio 서비스(`pnpm minio:up`)가 채움 — 아래 4개 모두 활성화.
# 운영: 관리형 S3 (예: S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com).
# 모두 비우면 파일 업로드 API는 호출 시 FILE_UPLOAD_FAILED 반환 (저장소 비활성 모드).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=candidate-web-resumes
S3_ACCESS_KEY=candidate
S3_SECRET_KEY=candidate-dev-secret
# BR-FILE-05: presigned URL 유효기간(초) — 기본 300(5분), 최대 900(15분).
S3_PRESIGN_TTL_SEC=300

# --- SMTP 이메일 발송 (CANDID-010부터 required) ---
# 회원가입 인증 메일 발송. dev/test는 Mailtrap(sandbox.smtp.mailtrap.io:2525) 또는 ethereal.email.
# 운영은 AWS SES / SendGrid / Mailgun 등 SMTP 호환 서비스. SMTP_FROM은 검증된 발신자 주소.
# 운영 배포 전 도메인의 SPF/DKIM/DMARC 설정 필수.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@candidate.example.com

# CANDID-023 — 지원 철회 어드민 Slack 알림 webhook (선택, 미설정 시 no-op)
SLACK_WEBHOOK_URL=
